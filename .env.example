# Ollama Service Connection
OLLAMA_BASE_URL=http://localhost:11434

# Multi Model Switch Config
DEBUG_LLM_MODEL=gemma3:270m
LIGHT_DEV_LLM_MODEL=qwen3:1.7b
SHOWCASE_LLM_MODEL=qwen2.5:14b

# Fixed Retrieval Models
EMBEDDING_MODEL=nomic-embed-text
RERANK_MODEL=dengcao/bge-reranker-v2-m3

# Persistent Storage Paths
CHROMA_STORAGE_PATH=./chroma_db
LOG_SAVE_PATH=./logs
TEST_DOCUMENT_FOLDER=./test_materials
CHAT_SESSION_STORAGE=./chat_memory_store