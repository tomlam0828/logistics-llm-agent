# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# LLM Models
DEBUG_LLM_MODEL=qwen2.5:14b
LIGHT_DEV_LLM_MODEL=qwen2.5:14b
SHOWCASE_LLM_MODEL=qwen2.5:14b
LLM_TEMPERATURE=0

# Embedding & Rerank
EMBEDDING_MODEL=nomic-embed-text
RERANK_MODEL=BAAI/bge-reranker-base

# File Paths
CHROMA_STORAGE_PATH=./chroma_db
LOG_SAVE_PATH=./logs
TEST_DOCUMENT_FOLDER=./data
CHAT_SESSION_STORAGE=./chat_memory_store